{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for FrameTrain",
  "windows": ["main", "quickchat"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "os:default",
    "dialog:default",
    "fs:default",
    "updater:default",
    "process:allow-restart",
    "core:window:allow-start-dragging"
  ]
}
