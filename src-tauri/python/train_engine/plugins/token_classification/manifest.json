{
  "task_type": "token_classification",
  "name": "Token Classification (HuggingFace)",
  "version": "1.0",
  "entry": "plugin.py",
  "class": "Plugin",
  "description": "Trainiert Encoder-Modelle fuer Token-Labels: Named Entity Recognition (NER), Wortarten (POS) und aehnliche Aufgaben.",
  "supported_architectures": [
    "bert", "distilbert", "roberta", "xlm-roberta", "deberta", "deberta-v2",
    "electra", "albert", "camembert", "mpnet", "rembert", "ernie", "funnel",
    "squeezebert", "layoutlm", "longformer", "mobilebert", "convbert", "modernbert"
  ],
  "dataset_formats": ["jsonl", "json", "parquet", "conll"],
  "metrics": ["train_loss", "val_loss", "accuracy", "f1", "precision", "recall"]
}
