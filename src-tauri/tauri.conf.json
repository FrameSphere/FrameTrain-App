{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FrameTrain",
  "version": "1.2.16",
  "identifier": "com.frametrain.desktop",
  "build": {
    "beforeDevCommand": "npx vite --port 5003",
    "devUrl": "http://localhost:5003",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "python"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FrameTrain",
        "width": 1400,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; media-src 'self' blob: data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https: http://localhost:*",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4OEM4NjY4MjRGRjQ0RDcKUldUWFJQOGthSWFNcUQ3bjU3MHNhczhOcTlwVTFyRDgxUjFGYjFLaWF0djRPOHVBUHROZ1ZrQXkK",
      "endpoints": [
        "https://github.com/FrameSphere/FrameTrain-App/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
