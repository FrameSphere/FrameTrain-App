{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FrameTrain",
  "version": "1.8.0",
  "identifier": "com.frametrain.desktop",
  "build": {
    "beforeDevCommand": "npx vite --port 5003",
    "devUrl": "http://localhost:5003",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "python"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "FrameTrain",
        "width": 1400,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundThrottling": "disabled",
        "trafficLightPosition": {
          "x": 22,
          "y": 24
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; media-src 'self' blob: data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost https: http://localhost:*",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "deny": [
            "$APPDATA/*.json",
            "$APPDATA/*.db",
            "$APPDATA/*.db-*",
            "$APPCONFIG/*.json",
            "$APPLOG/**",
            "$HOME/Library/Keychains/**",
            "$HOME/Library/Cookies/**",
            "$HOME/Library/Mail/**",
            "$HOME/Library/Messages/**",
            "$HOME/Library/Application Support/Google/**",
            "$HOME/Library/Application Support/Firefox/**",
            "$HOME/Library/Application Support/BraveSoftware/**",
            "$HOME/Library/Application Support/Microsoft Edge/**",
            "$HOME/Library/Application Support/Claude/**",
            "$HOME/Library/Safari/**",
            "$HOME/AppData/Local/Google/**",
            "$HOME/AppData/Local/Microsoft/Edge/**",
            "$HOME/AppData/Roaming/Mozilla/**",
            "$HOME/AppData/Roaming/Microsoft/Credentials/**",
            "$HOME/AppData/Roaming/Claude/**"
          ],
          "requireLiteralLeadingDot": true
        }
      }
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4OEM4NjY4MjRGRjQ0RDcKUldUWFJQOGthSWFNcUQ3bjU3MHNhczhOcTlwVTFyRDgxUjFGYjFLaWF0djRPOHVBUHROZ1ZrQXkK",
      "endpoints": [
        "https://github.com/FrameSphere/FrameTrain-Releases/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
